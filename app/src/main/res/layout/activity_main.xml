<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">
            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="Tic and Terry logo" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" android:text="TIC &amp; TERRY" android:textColor="#8CC63F" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:text="Delivery" android:textColor="@android:color/white" android:textSize="25sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Secure corporate driver services" android:textColor="#B9C9E4" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUSH TO TALK" android:textColor="@color/bc_blue" android:textStyle="bold" />
            <TextView android:id="@+id/pttStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Sign in to join the company-wide radio channel" android:textColor="@color/bc_muted" />
            <Button android:id="@+id/pttButton" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_primary" android:text="Hold to Talk" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Delivery Trip" android:textColor="@color/bc_text" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Enter or scan the Delivery Trip code" android:textColor="@color/bc_muted" android:textSize="13sp" />
            <TextView android:id="@+id/connectivityStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_status" android:text="● CHECKING CONNECTION" android:textColor="@color/bc_muted" android:textSize="13sp" android:textStyle="bold" />
            <EditText android:id="@+id/driverId" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="Driver ID (automatic from ERPNext user)" android:singleLine="true" android:textColor="@color/bc_text" android:visibility="gone" />
            <EditText android:id="@+id/deliveryTrip" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="MAT-DT-2026-00001" android:singleLine="true" android:textColor="@color/bc_text" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <Button android:id="@+id/scanTrip" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_button_primary" android:text="Scan QR" android:textAllCaps="false" android:textColor="@android:color/white" />
                <Button android:id="@+id/searchTrip" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:text="My Trips" android:textAllCaps="false" android:textColor="@android:color/white" />
            </LinearLayout>
            <Spinner android:id="@+id/routePhase" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:entries="@array/route_phases" />
            <Button android:id="@+id/openTripMap" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/bg_button_secondary" android:text="Open Delivery Trip Map" android:textAllCaps="false" android:textColor="@android:color/white" android:visibility="gone" />
            <Button android:id="@+id/loadTrip" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/bg_button_secondary" android:text="Load / Refresh Delivery Stops" android:textAllCaps="false" android:textColor="@android:color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="DELIVERIES" android:textColor="@color/bc_blue" android:textStyle="bold" />
            <TextView android:id="@+id/deliverySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Load a trip to view deliveries" android:textColor="@color/bc_muted" />
            <CheckBox android:id="@+id/showAllDeliveries" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="6dp" android:buttonTint="@color/bc_blue" android:text="Show completed deliveries" android:textColor="@color/bc_text" android:textSize="14sp" />
            <LinearLayout android:id="@+id/deliveryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <Button android:id="@+id/tripStarted" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:singleLine="true" android:text="Start Trip" android:textAllCaps="false" android:textSize="@dimen/bc_trip_action_text_size" />
                <Button android:id="@+id/tripCompleted" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:singleLine="true" android:text="End Deliveries" android:textAllCaps="false" android:textSize="@dimen/bc_trip_action_text_size" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/deliveryStarted" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Start Delivery" android:textAllCaps="false" android:visibility="gone" />
                <Button android:id="@+id/deliveryCompleted" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Complete" android:textAllCaps="false" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/returnStarted" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:singleLine="true" android:text="Start Return" android:textAllCaps="false" android:textSize="@dimen/bc_trip_action_text_size" android:visibility="gone" />
                <Button android:id="@+id/returnedWarehouse" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:singleLine="true" android:text="At Warehouse" android:textAllCaps="false" android:textSize="@dimen/bc_trip_action_text_size" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="14dp" android:layout_marginEnd="18dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROUTE MAP" android:textColor="@color/bc_blue" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="View assigned stops, actual route, and return journey" android:textColor="@color/bc_muted" />
            <WebView android:id="@+id/routeMapPreview" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="12dp" android:background="#E8EEF6" />
            <Button android:id="@+id/refreshRouteMap" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_button_secondary" android:text="Refresh Route &amp; Deliveries" android:textAllCaps="false" android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Tic and Terry logo"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="TIC &amp; TERRY"
                    android:textColor="@color/bc_cyan"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Delivery"
                    android:textColor="@android:color/white"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Secure device location services"
                    android:textColor="#B9C9E4"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="●  LIVE DEVICE STATUS"
                android:textColor="@color/bc_success"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:text="Tracking is stopped."
                android:textColor="@color/bc_text"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Device Readiness"
                android:textColor="@color/bc_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="Checking corporate tracking requirements…"
                android:textColor="@color/bc_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/completeSetup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="Complete Required Setup"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="System Configuration"
                android:textColor="@color/bc_text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="16dp"
                android:text="ERPNext connection and reporting policy"
                android:textColor="@color/bc_muted"
                android:textSize="13sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERVER ENDPOINT" android:textColor="@color/bc_muted" android:textSize="11sp" android:letterSpacing="0.05" />
            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="https://server/api/method/..."
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/bc_text"
                android:textColorHint="#94A1B4"
                android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="DRIVER EMAIL" android:textColor="@color/bc_muted" android:textSize="11sp" android:letterSpacing="0.05" />
            <EditText
                android:id="@+id/loginEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="name@company.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/bc_text"
                android:textColorHint="#94A1B4"
                android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="PASSWORD" android:textColor="@color/bc_muted" android:textSize="11sp" android:letterSpacing="0.05" />
            <EditText
                android:id="@+id/loginPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="ERPNext password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/bc_text"
                android:textColorHint="#94A1B4"
                android:textSize="14sp" />
            <TextView android:id="@+id/loginStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Not signed in" android:textColor="@color/bc_muted" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <Button android:id="@+id/signIn" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_button_primary" android:text="Sign In" android:textAllCaps="false" android:textColor="@android:color/white" />
                <Button android:id="@+id/signOut" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:text="Sign Out" android:textAllCaps="false" android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="7dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE ID" android:textColor="@color/bc_muted" android:textSize="11sp" android:letterSpacing="0.05" />
                    <EditText android:id="@+id/deviceId" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="Device identifier" android:inputType="text" android:singleLine="true" android:textColor="@color/bc_text" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="112dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INTERVAL (MIN)" android:textColor="@color/bc_muted" android:textSize="11sp" android:letterSpacing="0.05" />
                    <EditText android:id="@+id/interval" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:gravity="center" android:hint="5" android:inputType="number" android:singleLine="true" android:textColor="@color/bc_text" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/startOnBoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/bc_blue"
                android:checked="true"
                android:text="Resume tracking after device restart"
                android:textColor="@color/bc_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="Save &amp; Start Tracking"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/sendNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="Send Current Location"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/stop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_danger"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="Stop Tracking"
                android:textAllCaps="false"
                android:textColor="@color/bc_danger"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="TIC &amp; TERRY  •  DELIVERY OPERATIONS"
            android:textColor="@color/bc_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/versionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="App Version"
            android:textColor="#8996A8"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
