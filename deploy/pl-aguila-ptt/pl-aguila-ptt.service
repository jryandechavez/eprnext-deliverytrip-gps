[Unit]
Description=PL Aguila memory-only PTT relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pl-aguila-ptt
Environment=NODE_ENV=production
Environment=PORT=8765
Environment=ERP_URL=https://soa.pl-aguila.com
Environment=REGISTRY_FILE=/var/lib/pl-aguila-ptt/ios-devices.json
ExecStart=/usr/bin/node /opt/pl-aguila-ptt/server.js
Restart=always
RestartSec=2
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=pl-aguila-ptt
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
